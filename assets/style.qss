/* ============================================================
   BCLS Joystick 视觉样式 — Moog 蓝色系主题（对齐 MoogStyle 参考）
   配色: 蓝 #4A90D9 + 灰白；主窗口底 #d6d6d6
   Python 侧只设 objectName / 动态属性，颜色尺寸全在这里调
   ============================================================ */

/* ---------- 全局 ---------- */
QWidget {
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13pt;
    color: #333333;
}

QMainWindow {
    background-color: #d6d6d6;
}

/* ---------- 顶部蓝条（对齐参考 #headerBar 深蓝渐变） ---------- */
QFrame#TopBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(219,233,255,255),
        stop:0.5 rgba(169,205,230,255),
        stop:1 rgba(119,165,206,255));
    border: none;
    border-bottom: 1px solid #86bfe2;
}

QFrame#TopBar QLabel {
    color: #1a3a5c;
    background: transparent;
}

QLabel#BarTitle {
    font-size: 16pt;
    font-weight: bold;
    letter-spacing: 2px;
}

QLabel#LedLabel {
    background: transparent;
    border-radius: 16px;
}

/* 网络连接文字（非按钮，跟随指示灯） */
QLabel#LinkText {
    color: #1a3a5c;
    font-weight: bold;
    font-size: 13pt;
}

/* 蓝条内「返回预设管理」按钮 */
QPushButton#BackButton {
    background: #1a5276;
    color: #ffffff;
    border: 1px solid #154360;
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 12pt;
    font-weight: bold;
}
QPushButton#BackButton:hover  { background: #2471a3; }
QPushButton#BackButton:pressed { background: #154360; }

/* 作为主机按钮：选中变蓝（对齐 MoogStyle #btnHost），旁边指示灯同步状态 */
QPushButton#HostButton {
    background: #ffffff;
    color: #333333;
    border: 1px solid #999999;
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 13pt;
    font-weight: bold;
}
QPushButton#HostButton:hover {
    background: #ebf3fd;
    border: 1px solid #4a90d9;
    color: #333333;
}
QPushButton#HostButton:checked {
    background: #4a90d9;
    color: #ffffff;
    border: 1px solid #2060a0;
}
QPushButton#HostButton:pressed {
    background: #c8dcef;
    color: #1a3a5c;
    border: 1px solid #2060a0;
}

/* ---------- 按钮 — Moog 扁平风格 ---------- */
QPushButton {
    border: 1px solid #c8c8c8;
    border-radius: 4px;
    background-color: #ffffff;
    padding: 2px 14px;
    min-width: 68px;
    min-height: 26px;
    color: #333333;
    font-size: 13pt;
}

QPushButton:hover {
    border: 1px solid #4a90d9;
    background-color: #ebf3fd;
    color: #4a90d9;
}

QPushButton:pressed {
    border: 1px solid #2060a0;
    background-color: #c8dcef;
    color: #1a3a5c;
}

QPushButton:disabled {
    background-color: #f0f0f0;
    border: 1px solid #d8d8d8;
    color: #a0a0a0;
}

/* ---------- 输入框 ---------- */
QLineEdit {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #c8c8c8;
    border-radius: 4px;
    padding: 2px 6px;
    min-height: 22px;
    font-size: 13pt;
    selection-background-color: #4a90d9;
}

QLineEdit:focus {
    border: 1px solid #4a90d9;
}

QLineEdit:disabled {
    background-color: #f0f0f0;
    color: #a0a0a0;
    border: 1px solid #e0e0e0;
}

/* 脏标记：已修改未下发 = 蓝字（决策 10）
   UI 代码在字段 dirty 时 setProperty("dirty", True) 并刷新样式 */
QLineEdit[dirty="true"] {
    color: #1565d8;
    font-weight: bold;
}

/* 只读态 */
QLineEdit[readOnly="true"] {
    background: #f5f5f5;
    color: #666666;
    border: 1px solid #e0e0e0;
}

/* ---------- 分组框 — Moog 卡片风 ---------- */
QGroupBox {
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    margin-top: 1.6ex;
    background-color: #ffffff;
    font-weight: bold;
    color: #444444;
    font-size: 13pt;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #555555;
    background-color: #ffffff;
}

QGroupBox QLabel { font-weight: normal; }

/* ---------- 树状预设列表 ---------- */
QTreeWidget {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    font-size: 13pt;
    outline: none;
    alternate-background-color: #fafafa;
}

QTreeWidget::item {
    padding: 6px 10px;
    min-height: 28px;
}

QTreeWidget::item:hover {
    background-color: rgba(74,144,217,0.10);
}

QTreeWidget::item:selected {
    background-color: #ebf3fd;
    color: #4a90d9;
}

QHeaderView::section {
    background-color: #e8e8e8;
    color: #555555;
    border: none;
    border-bottom: 2px solid #4a90d9;
    border-right: 1px solid #e0e0e0;
    padding: 6px 8px;
    font-weight: bold;
    font-size: 12pt;
}

/* ---------- 通道编辑页 Tab（俯仰/滚转） ---------- */
QTabWidget::pane {
    border: 1px solid #d0d0d0;
    border-top: none;
    background-color: #ffffff;
}

QTabBar::tab {
    background: #f0f0f0;
    color: #666666;
    border: 1px solid #d0d0d0;
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    padding: 5px 24px;
    min-width: 90px;
    min-height: 24px;
    font-weight: bold;
    font-size: 13pt;
    margin-right: 1px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #4a90d9;
    border-bottom: 2px solid #4a90d9;
}

QTabBar::tab:hover:!selected {
    background: #ebf3fd;
    color: #4a90d9;
}

/* ---------- 复选（标定曲线等） ---------- */
QCheckBox {
    color: #333333;
    font-size: 13pt;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border: 1px solid #4a90d9;
}

QCheckBox::indicator:checked {
    background-color: #4a90d9;
    border: 1px solid #2060a0;
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background-color: #f0f0f0;
    color: #666666;
    border-top: 1px solid #d0d0d0;
    font-size: 12pt;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background-color: #e8e8e8;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #b8b8b8;
    min-height: 24px;
    border-radius: 5px;
    margin: 2px 2px;
}
QScrollBar::handle:vertical:hover { background-color: #888888; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background-color: #e8e8e8;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background-color: #b8b8b8;
    min-width: 24px;
    border-radius: 5px;
    margin: 2px 2px;
}
QScrollBar::handle:horizontal:hover { background-color: #888888; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- 18 点表区标题与表头 ---------- */
QLabel#HalfCaption {
    color: #2f5d8a;
    font-weight: bold;
}
QLabel#PointHeader { color: #666666; font-size: 11pt; }
QLabel#PointNo { color: #999999; font-size: 11pt; }

/* ---------- 预设管理页右侧操作面板 ---------- */
QWidget#PresetRightPanel {
    background: #fafafa;
    border-left: 1px solid #d8d8d8;
}
QWidget#PresetRightPanel QPushButton { min-height: 26px; }

QLabel#ChName { font-weight: bold; color: #333333; }
QLabel#Hint { color: #808080; font-size: 11pt; }

/* ---------- 菜单栏 / 菜单（决策 25：设置→网络绑定…） ---------- */
QMenuBar#MainMenuBar {
    background: #eef4fb;
    border-bottom: 1px solid #c0d6e8;
    padding: 2px 6px;
}
QMenuBar#MainMenuBar::item {
    background: transparent;
    padding: 4px 14px;
    border-radius: 4px;
}
QMenuBar#MainMenuBar::item:selected {
    background: #4a90d9;
    color: #ffffff;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #b8cfe2;
    padding: 4px;
}
QMenu::item {
    padding: 6px 22px 6px 14px;
    border-radius: 3px;
}
QMenu::item:selected {
    background-color: #4a90d9;
    color: #ffffff;
}
QMenu::item:disabled { color: #a0a0a0; }

/* ---------- 网络绑定对话框 ---------- */
QDialog {
    background: #fafcfe;
}
QDialog QLabel { color: #333333; }
QDialog QLineEdit { min-height: 22px; }
QDialog QDialogButtonBox QPushButton {
    min-width: 84px;
    min-height: 26px;
}
